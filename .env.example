# Copy this file to .env and fill in your values. Never commit .env!

# Database (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://velocite:velocite123@localhost:5432/velocite

# Redis (optional — the API falls back to an in-memory cache)
REDIS_URL=redis://localhost:6379

# Currency API (optional — approximate rates are used if it is down)
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Admin endpoints (/api/v1/admin/*) require the header X-Admin-Token
ADMIN_TOKEN=change-me

# Generate demo listings for Azerbaijan when the database is empty
AUTO_SEED=true
SEED_LISTINGS_PER_MARKET=80

# Comma-separated list of allowed frontend origins, or *
CORS_ORIGINS=*
